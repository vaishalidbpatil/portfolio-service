@page
@model Portfolio.TradeOrderService.Auth.Pages.Account.LoginModel
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — Trade Order Service</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0d1117; color: #c9d1d9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
  .card { background: #161b22; border: 1px solid #30363d; border-radius: 10px; padding: 2.5rem; width: 100%; max-width: 380px; }
  h1 { font-size: 1.25rem; font-weight: 700; color: #f0f6fc; margin-bottom: 0.25rem; }
  .subtitle { font-size: 0.8rem; color: #8b949e; margin-bottom: 2rem; }
  label { display: block; font-size: 0.8rem; color: #8b949e; margin-bottom: 0.4rem; font-weight: 600; }
  input { width: 100%; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 0.6rem 0.75rem; color: #c9d1d9; font-size: 0.875rem; margin-bottom: 1rem; outline: none; }
  input:focus { border-color: #58a6ff; }
  button { width: 100%; background: #238636; border: 1px solid #2ea043; border-radius: 6px; color: #fff; padding: 0.65rem; font-size: 0.875rem; font-weight: 600; cursor: pointer; margin-top: 0.5rem; }
  button:hover { background: #2ea043; }
  .error { background: #3d1f1f; border: 1px solid #8b2020; border-radius: 6px; padding: 0.75rem; color: #f85149; font-size: 0.8rem; margin-bottom: 1rem; }
  .hint { margin-top: 1.25rem; font-size: 0.75rem; color: #484f58; text-align: center; }
  .hint code { color: #8b949e; }
</style>
</head>
<body>
<div class="card">
  <h1>Trade Order Service</h1>
  <p class="subtitle">Sign in to continue</p>

  @if (Model.Error is not null)
  {
    <div class="error">@Model.Error</div>
  }

  <form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label>Username</label>
    <input asp-for="Username" autocomplete="username" autofocus />
    <label>Password</label>
    <input asp-for="Password" type="password" autocomplete="current-password" />
    <button type="submit">Sign in</button>
  </form>

  <p class="hint">Demo credentials: <code>demo / demo123</code></p>
</div>
</body>
</html>
